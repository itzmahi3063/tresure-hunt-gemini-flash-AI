{
  "rewrites": [
    {
      "source": "/api/webhook",
      "destination": "/api/webhook.js"
    },
    {
      "source": "/api/test",
      "destination": "/api/test.js"
    },
    {
      "source": "/api/mandatory-channels/(.*)",
      "destination": "/api/mandatory-channels.js"
    },
    {
      "source": "/api/mandatory-channels",
      "destination": "/api/mandatory-channels.js"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
