# Telegram Bot Token from @BotFather
BOT_TOKEN=your_bot_token_here

# Authorized Admin Telegram User ID (keeps /admin strictly confidential)
ADMIN_ID=your_telegram_user_id_here

# Frontend Mini App URL (e.g. Vercel deployment URL)
WEBAPP_URL=https://your-app.vercel.app

# MongoDB Atlas Connection URI
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.zdfkunq.mongodb.net/?retryWrites=true&w=majority

# Server Port
PORT=5000
NODE_ENV=production

# TON Blockchain & TonConsole Payment Configuration
TON_WALLET_ADDRESS=your_ton_wallet_address_here
TONCONSOLE_API_KEY=your_tonconsole_api_key_here
TONCONSOLE_WEBHOOK_SECRET=your_webhook_secret_here
