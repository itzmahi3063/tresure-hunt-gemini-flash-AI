# ========================================================
# TREASURE HUNT - VERCEL ENVIRONMENT VARIABLES
# ========================================================

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather

# Admin Telegram ID (for withdrawal approval, broadcast, alerts)
ADMIN_TELEGRAM_ID=your_numeric_telegram_id

# Admin Secret Key (for admin panel & API auth)
ADMIN_SECRET_KEY=set_a_long_random_secret

# Adsgram Server-To-Server (S2S) Secret Key
# Configure the same secret here in Vercel and in your Adsgram Dashboard S2S Postback URL!
ADSGRAM_S2S_SECRET=set_a_long_random_secret

# Cron Secret for cron-job.org triggers
CRON_SECRET=set_a_long_random_secret

# MongoDB Connection String & Database Name
MONGODB_URI=mongodb+srv://...
MONGODB_DB=hoocooh_mine

# TON Blockchain Hot Wallet & Automated On-Chain Payout Configuration
# TON_WALLET_MNEMONIC: 24 secret words of your hot wallet (Tonkeeper / MyTonWallet)
# Can also be configured directly via Admin Panel (Withdrawals -> Setup 24 Words)!
TON_WALLET_ADDRESS=your_hot_wallet_address
TON_WALLET_MNEMONIC=word1 word2 word3 word4 word5 word6 word7 word8 word9 word10 word11 word12 word13 word14 word15 word16 word17 word18 word19 word20 word21 word22 word23 word24
TON_AUTO_PAY=true

# Channel ID for Payout Logs
PAYOUT_CHANNEL_ID=@your_payout_log_channel

# Optional: random secret used to sign reward action tokens (falls back to TELEGRAM_BOT_TOKEN)
ACTION_SIGNING_SECRET=set_a_long_random_secret
# Optional: seconds-level wait for on-chain confirmation per payout (ms)
# TON_CONFIRM_BUDGET_MS=14000
